<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Cli\**\*.cs" />
    <Compile Remove="CliDefinition\**\*.cs" />
    <EmbeddedResource Remove="Cli\**\*" />
    <EmbeddedResource Remove="CliDefinition\**\*" />
    <None Remove="Cli\**\*" />
    <None Remove="CliDefinition\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meta.Integration" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.TypedModels" Version="$(MetaFoundationPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Workspaces\MetaTransformBinding\**\*">
      <Link>Workspaces\MetaTransformBinding\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Workspaces\MetaTransformBinding\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Script\Sql\MetaTransformScript.Sql.csproj" />
    <ProjectReference Include="..\..\MetaSchema\Core\MetaSchema.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Package\MetaTransform.Binding.targets" Pack="true" PackagePath="buildTransitive\MetaTransform.Binding.targets" />
  </ItemGroup>

</Project>
