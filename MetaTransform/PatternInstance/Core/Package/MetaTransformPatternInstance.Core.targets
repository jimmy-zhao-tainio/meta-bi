<Project>
  <ItemGroup>
    <_MetaTransformPatternInstancePackagedWorkspace Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/Workspaces/MetaTransformPatternInstance/**/*" />
  </ItemGroup>
  <Target Name="CopyMetaTransformPatternInstancePackagedWorkspaceToOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_MetaTransformPatternInstancePackagedWorkspace)" DestinationFiles="@(_MetaTransformPatternInstancePackagedWorkspace -> '$(OutDir)Workspaces/MetaTransformPatternInstance/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMetaTransformPatternInstancePackagedWorkspaceToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <Copy SourceFiles="@(_MetaTransformPatternInstancePackagedWorkspace)" DestinationFiles="@(_MetaTransformPatternInstancePackagedWorkspace -> '$(PublishDir)Workspaces/MetaTransformPatternInstance/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
