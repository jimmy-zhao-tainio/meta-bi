<?xml version="1.0" encoding="utf-8"?>
<MetaCli>
  <CommandList>
    <Command Id="cmd-add-instance" ApplicationId="app-meta-transform-pattern">
      <Description>Add one concrete instance of a reusable transform pattern.</Description>
      <Name>add-instance</Name>
      <Token>add-instance</Token>
    </Command>
    <Command Id="cmd-add-pattern" ApplicationId="app-meta-transform-pattern">
      <Description>Read a pattern projection from standard input and add it.</Description>
      <Name>add-pattern</Name>
      <Token>add-pattern</Token>
    </Command>
    <Command Id="cmd-clear-binding" ApplicationId="app-meta-transform-pattern">
      <Description>Set one instance placeholder to empty SQL text.</Description>
      <Name>clear-binding</Name>
      <Token>clear-binding</Token>
    </Command>
    <Command Id="cmd-create" ApplicationId="app-meta-transform-pattern">
      <Description>Create an empty MetaTransformPattern workspace.</Description>
      <Name>create</Name>
      <Token>create</Token>
    </Command>
    <Command Id="cmd-create-instance-workspace" ApplicationId="app-meta-transform-pattern">
      <Description>Create an empty MetaTransformPatternInstance workspace.</Description>
      <Name>create-instance-workspace</Name>
      <Token>create-instance-workspace</Token>
    </Command>
    <Command Id="cmd-emit-pattern" ApplicationId="app-meta-transform-pattern">
      <Description>Write one pattern as its editable text projection.</Description>
      <Name>emit-pattern</Name>
      <Token>emit-pattern</Token>
    </Command>
    <Command Id="cmd-help" ApplicationId="app-meta-transform-pattern">
      <Description>Show help.</Description>
      <Name>help</Name>
      <Token>help</Token>
    </Command>
    <Command Id="cmd-set-binding" ApplicationId="app-meta-transform-pattern">
      <Description>Replace one instance placeholder with a SQL fragment read from standard input.</Description>
      <Name>set-binding</Name>
      <Token>set-binding</Token>
    </Command>
    <Command Id="cmd-show" ApplicationId="app-meta-transform-pattern">
      <Description>Show reusable transform-pattern definitions.</Description>
      <Name>show</Name>
      <Token>show</Token>
    </Command>
    <Command Id="cmd-show-instances" ApplicationId="app-meta-transform-pattern">
      <Description>Show concrete pattern instances and placeholder coverage.</Description>
      <Name>show-instances</Name>
      <Token>show-instances</Token>
    </Command>
    <Command Id="cmd-update-pattern" ApplicationId="app-meta-transform-pattern">
      <Description>Read a replacement pattern projection from standard input.</Description>
      <Name>update-pattern</Name>
      <Token>update-pattern</Token>
    </Command>
  </CommandList>
</MetaCli>
