<Project>
  <ItemGroup>
    <_MetaSqlScriptPackagedWorkspace Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/Workspaces/MetaSqlScript/**/*" />
  </ItemGroup>
  <Target Name="CopyMetaSqlScriptPackagedWorkspaceToOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_MetaSqlScriptPackagedWorkspace)" DestinationFiles="@(_MetaSqlScriptPackagedWorkspace -> '$(OutDir)Workspaces/MetaSqlScript/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMetaSqlScriptPackagedWorkspaceToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <Copy SourceFiles="@(_MetaSqlScriptPackagedWorkspace)" DestinationFiles="@(_MetaSqlScriptPackagedWorkspace -> '$(PublishDir)Workspaces/MetaSqlScript/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
