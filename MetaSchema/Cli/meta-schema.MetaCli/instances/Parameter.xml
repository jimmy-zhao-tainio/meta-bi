<?xml version="1.0" encoding="utf-8"?>
<MetaCli>
  <ParameterList>
    <Parameter Id="param-extract-sqlserver-new-workspace" ValueShapeId="shape-path">
      <Description>Directory where the MetaSchema workspace will be created.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>true</IsRequired>
      <Name>new-workspace</Name>
    </Parameter>
    <Parameter Id="param-extract-sqlserver-connection-env" ValueShapeId="shape-text">
      <Description>Environment variable containing the SQL Server connection string.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>true</IsRequired>
      <Name>connection-env</Name>
    </Parameter>
    <Parameter Id="param-extract-sqlserver-system" ValueShapeId="shape-text">
      <Description>Source system name recorded in the workspace.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>true</IsRequired>
      <Name>system</Name>
    </Parameter>
    <Parameter Id="param-extract-sqlserver-schema" ValueShapeId="shape-text">
      <Description>Extract one SQL Server schema.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>false</IsRequired>
      <Name>schema</Name>
    </Parameter>
    <Parameter Id="param-extract-sqlserver-all-schemas" ValueShapeId="shape-flag">
      <Description>Extract all SQL Server schemas in scope.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>false</IsRequired>
      <Name>all-schemas</Name>
    </Parameter>
    <Parameter Id="param-extract-sqlserver-table" ValueShapeId="shape-text">
      <Description>Extract one SQL Server table or view.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>false</IsRequired>
      <Name>table</Name>
    </Parameter>
    <Parameter Id="param-extract-sqlserver-all-tables" ValueShapeId="shape-flag">
      <Description>Extract all SQL Server tables and views in scope.</Description>
      <IsRepeatable>false</IsRepeatable>
      <IsRequired>false</IsRequired>
      <Name>all-tables</Name>
    </Parameter>
  </ParameterList>
</MetaCli>
