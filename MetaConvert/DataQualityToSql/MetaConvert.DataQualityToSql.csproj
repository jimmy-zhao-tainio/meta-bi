<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meta.Integration" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.Operations" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="MetaWeave.Core" Version="$(MetaFoundationPackageVersion)" />
    <ProjectReference Include="..\..\MetaDataQuality\Core\MetaDataQuality.Core.csproj" />
    <ProjectReference Include="..\..\MetaSql\CSharp\MetaSql.CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Package\MetaConvert.DataQualityToSql.targets" Pack="true" PackagePath="buildTransitive\MetaConvert.DataQualityToSql.targets" />
    <Content Include="..\Weaves\DataQualityToSql\**\*">
      <Link>Weaves\DataQualityToSql\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Weaves\DataQualityToSql\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="MetaDQ.Operational.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\any\MetaDQ.Operational.sql" PackageCopyToOutput="true" />
    <Content Include="MetaDQ.Explain.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\any\MetaDQ.Explain.sql" PackageCopyToOutput="true" />
  </ItemGroup>

</Project>
