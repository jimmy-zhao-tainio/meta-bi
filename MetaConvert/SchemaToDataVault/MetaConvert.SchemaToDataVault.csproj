<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meta.Core" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.Integration" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="MetaWeave.Core" Version="$(MetaFoundationPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MetaSchema\Core\MetaSchema.Core.csproj" />
    <ProjectReference Include="..\..\MetaDataVault\Core\MetaDataVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Workspaces\MetaSchemaToRawDataVaultOptions\MetaSchemaToRawDataVaultOptions.meta.cs"
             Link="Workspaces\MetaSchemaToRawDataVaultOptions.meta.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Weaves\SchemaToRawDataVault\**\*">
      <Link>Weaves\SchemaToRawDataVault\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Weaves\SchemaToRawDataVault\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="..\Workspaces\MetaSchemaToRawDataVaultOptions\**\*">
      <Link>Workspaces\MetaSchemaToRawDataVaultOptions\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Workspaces\MetaSchemaToRawDataVaultOptions\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
