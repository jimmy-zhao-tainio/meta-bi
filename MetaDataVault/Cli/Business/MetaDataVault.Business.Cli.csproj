<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>meta-datavault-business</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetaCli.Core" Version="$(MetaFoundationPackageVersion)" />
    <ProjectReference Include="..\..\Core\MetaDataVault.Core.csproj" />
    <ProjectReference Include="..\..\..\MetaSql\Core\MetaSql.Core.csproj" />
    <ProjectReference Include="..\..\..\MetaSql\Extractors.SqlServer\MetaSql.Extractors.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\MetaSql\CSharp\MetaSql.CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="meta-datavault-business.MetaCli\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
