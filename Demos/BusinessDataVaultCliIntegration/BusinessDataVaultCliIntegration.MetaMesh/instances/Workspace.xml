<?xml version="1.0" encoding="utf-8"?>
<MetaMesh>
  <WorkspaceList>
    <Workspace Id="workspace:business-data-vault" MeshId="mesh:default">
      <Description>Generated business data vault workspace authored by the demo operation.</Description>
      <ModelName>MetaBusinessDataVault</ModelName>
      <Name>business-data-vault</Name>
      <Path>BusinessDataVaultCliIntegrationWorkspace</Path>
    </Workspace>
    <Workspace Id="workspace:business-data-vault-implementation" MeshId="mesh:default">
      <Description>Implementation policy workspace used by the Data Vault to SQL converter.</Description>
      <ModelName>MetaDataVaultImplementation</ModelName>
      <Name>business-data-vault-implementation</Name>
      <Path>..\..\MetaDataVault\Workspaces\MetaDataVaultImplementation</Path>
    </Workspace>
    <Workspace Id="workspace:deploy-manifest" MeshId="mesh:default">
      <Description>Generated deployment manifest for the first SQL deploy.</Description>
      <ModelName>MetaSqlDeployManifest</ModelName>
      <Name>deploy-manifest</Name>
      <Path>MetaSqlDeployManifest</Path>
    </Workspace>
    <Workspace Id="workspace:sql" MeshId="mesh:default">
      <Description>Generated MetaSql workspace produced from the business data vault model.</Description>
      <ModelName>MetaSql</ModelName>
      <Name>sql</Name>
      <Path>CurrentMetaSqlWorkspace</Path>
    </Workspace>
    <Workspace Id="workspace:verify-manifest" MeshId="mesh:default">
      <Description>Generated verification manifest after deployment.</Description>
      <ModelName>MetaSqlDeployManifest</ModelName>
      <Name>verify-manifest</Name>
      <Path>MetaSqlVerifyManifest</Path>
    </Workspace>
  </WorkspaceList>
</MetaMesh>
