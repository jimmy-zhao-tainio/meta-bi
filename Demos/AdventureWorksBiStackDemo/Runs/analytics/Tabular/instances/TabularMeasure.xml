<?xml version="1.0" encoding="utf-8"?>
<MetaTabular>
  <TabularMeasureList>
    <TabularMeasure Id="AverageOrderValue" TabularTableId="SalesOrders">
      <DisplayFolder>Orders</DisplayFolder>
      <Expression>AVERAGE('Sales Orders'[Total Due Value])</Expression>
      <FormatString>#,0.00</FormatString>
      <Name>Average Order Value</Name>
    </TabularMeasure>
