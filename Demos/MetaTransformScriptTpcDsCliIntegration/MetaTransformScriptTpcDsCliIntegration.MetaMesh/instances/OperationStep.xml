<?xml version="1.0" encoding="utf-8"?>
<MetaMesh>
  <OperationStepList>
    <OperationStep Id="operation-step:bind-snapshot:bind-transforms" OperationId="operation:bind-snapshot">
      <Arguments>bind --transform-workspace "{workspace:transform.location}" --source-schema "{workspace:schema.location}" --target-schema "{workspace:schema.location}" --execute-system TpcDsSnapshot --execute-system-default-schema-name dbo --output-xml "{mesh.root}\BindingWS"</Arguments>
      <Executable>meta-transform-binding.exe</Executable>
      <Name>bind-transforms</Name>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:compare-canonical-sql" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:export-reimported-sql">
      <Arguments>/b "{mesh.root}\RoundTrippedViews.sql" "{mesh.root}\RoundTrippedViews.reimported.sql"</Arguments>
      <Executable>fc.exe</Executable>
      <Name>compare-canonical-sql</Name>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:export-reimported-sql" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:record-transform-roundtrip-diff">
      <Arguments>to sql-path --workspace "{mesh.root}\TransformRoundTripWS" --out RoundTrippedViews.reimported.sql</Arguments>
      <Executable>meta-transform-script.exe</Executable>
      <Name>export-reimported-sql</Name>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:export-roundtripped-views-file" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:export-roundtripped-views-folder">
      <Arguments>to sql-path --workspace "{mesh.root}\TransformWS" --out RoundTrippedViews.sql</Arguments>
      <Executable>meta-transform-script.exe</Executable>
      <Name>export-roundtripped-views-file</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:export-roundtripped-views-folder" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:import-q01">
      <Arguments>to sql-path --workspace "{mesh.root}\TransformWS" --out RoundTrippedViews</Arguments>
      <Executable>meta-transform-script.exe</Executable>
      <Name>export-roundtripped-views-folder</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:import-q01" OperationId="operation:build-tpc-ds-snapshot">
      <Arguments>from sql-files --manifest SourceViews.manifest.tsv --output-xml "{mesh.root}\TransformWS" --verbose</Arguments>
      <Executable>meta-transform-script.exe</Executable>
      <Name>import-source-corpus</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:print-sql-q01" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:export-roundtripped-views-file">
      <Arguments>to sql-code --workspace "{mesh.root}\TransformWS" --name tpcds.v_q01</Arguments>
      <Executable>meta-transform-script.exe</Executable>
      <Name>print-sql-q01</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:record-transform-roundtrip-diff" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:roundtrip-import-manifest">
      <Arguments>instance diff "{mesh.root}\TransformWS" "{mesh.root}\TransformRoundTripWS" --output-xml "{mesh.root}\TransformDiffWS"</Arguments>
      <Description>Record the expected transform representation and emitted-file provenance differences after re-importing SQL modules.</Description>
      <Executable>meta.exe</Executable>
      <ExpectedExitCode>1</ExpectedExitCode>
      <Name>record-transform-roundtrip-diff</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-tpc-ds-snapshot:roundtrip-import-manifest" OperationId="operation:build-tpc-ds-snapshot" PreviousStepId="operation-step:build-tpc-ds-snapshot:print-sql-q01">
      <Arguments>from sql-files --manifest RoundTrippedViews.manifest.tsv --output-xml "{mesh.root}\TransformRoundTripWS"</Arguments>
      <Description>Import emitted SQL modules through the semantic path manifest.</Description>
      <Executable>meta-transform-script.exe</Executable>
      <Name>roundtrip-import-manifest</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-binding-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-transform-roundtrip-workspace">
      <Arguments>/c if exist "{mesh.root}\BindingWS\*" rmdir /s /q "{mesh.root}\BindingWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-binding-workspace</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-reimported-sql" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-roundtripped-views-file">
      <Arguments>/c if exist "{mesh.root}\RoundTrippedViews.reimported.sql" del /q "{mesh.root}\RoundTrippedViews.reimported.sql"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-reimported-sql</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-roundtripped-views-file" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-roundtripped-views-folder">
      <Arguments>/c if exist "{mesh.root}\RoundTrippedViews.sql" del /q "{mesh.root}\RoundTrippedViews.sql"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-roundtripped-views-file</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-roundtripped-views-folder" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-sql-roundtrip-diff">
      <Arguments>/c if exist "{mesh.root}\RoundTrippedViews\*" rmdir /s /q "{mesh.root}\RoundTrippedViews"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-roundtripped-views-folder</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-sql-roundtrip-diff" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-transform-roundtrip-diff">
      <Arguments>/d /c if exist "{mesh.root}\MetaSqlDiffWS" rmdir /s /q "{mesh.root}\MetaSqlDiffWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-sql-roundtrip-diff</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-sql-roundtrip-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-sql-workspace">
      <Arguments>/c if exist "{mesh.root}\MetaSqlRoundTripWS\*" rmdir /s /q "{mesh.root}\MetaSqlRoundTripWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-sql-roundtrip-workspace</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-sql-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-binding-workspace">
      <Arguments>/c if exist "{mesh.root}\MetaSqlWS\*" rmdir /s /q "{mesh.root}\MetaSqlWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-sql-workspace</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-transform-roundtrip-diff" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-sql-roundtrip-workspace">
      <Arguments>/d /c if exist "{mesh.root}\TransformDiffWS" rmdir /s /q "{mesh.root}\TransformDiffWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-transform-roundtrip-diff</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-transform-roundtrip-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-transform-workspace">
      <Arguments>/c if exist "{mesh.root}\TransformRoundTripWS\*" rmdir /s /q "{mesh.root}\TransformRoundTripWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-transform-roundtrip-workspace</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-transform-workspace" OperationId="operation:cleanup">
      <Arguments>/c if exist "{mesh.root}\TransformWS\*" rmdir /s /q "{mesh.root}\TransformWS"</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-transform-workspace</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:compare-sql-projections:convert-roundtrip-transform-to-sql" OperationId="operation:compare-sql-projections" PreviousStepId="operation-step:compare-sql-projections:convert-transform-to-sql">
      <Arguments>transform-script-to-sql --workspace "{workspace:transform-roundtrip.location}" --database-name TpcDsSnapshot --output-xml "{mesh.root}\MetaSqlRoundTripWS"</Arguments>
      <Executable>meta-convert.exe</Executable>
      <Name>convert-roundtrip-transform-to-sql</Name>
    </OperationStep>
    <OperationStep Id="operation-step:compare-sql-projections:convert-transform-to-sql" OperationId="operation:compare-sql-projections">
      <Arguments>transform-script-to-sql --workspace "{workspace:transform.location}" --database-name TpcDsSnapshot --output-xml "{mesh.root}\MetaSqlWS"</Arguments>
      <Executable>meta-convert.exe</Executable>
      <Name>convert-transform-to-sql</Name>
    </OperationStep>
    <OperationStep Id="operation-step:compare-sql-projections:diff-sql-workspaces" OperationId="operation:compare-sql-projections" PreviousStepId="operation-step:compare-sql-projections:convert-roundtrip-transform-to-sql">
      <Arguments>instance diff "{mesh.root}\MetaSqlWS" "{mesh.root}\MetaSqlRoundTripWS" --output-xml "{mesh.root}\MetaSqlDiffWS"</Arguments>
      <Executable>meta.exe</Executable>
      <Name>diff-sql-workspaces</Name>
    </OperationStep>
  </OperationStepList>
</MetaMesh>
