      <Arguments>inspect --workspace "{workspace:data-quality.location}" --show-cases --show-candidate-ids</Arguments>
      <Executable>meta-data-quality.exe</Executable>
      <Name>inspect-data-quality</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-real-db-data-quality:promote-sql-capable-candidates" OperationId="operation:build-real-db-data-quality" PreviousStepId="operation-step:build-real-db-data-quality:inspect-data-quality">
      <Arguments>promote --workspace "{workspace:data-quality.location}" --candidate-kind ImpliedForeignKeyMissingReference --candidate-kind ImpliedUniqueKeyViolation --candidate-kind MinorityJoinPattern --candidate-kind IncompleteCompositeJoin --candidate-kind SuspiciousExtraJoinPredicate --candidate-kind InnerJoinAgainstUsuallyOptionalRelationship --candidate-kind LeftJoinAgainstUsuallyMandatoryRelationship</Arguments>
      <Executable>meta-data-quality.exe</Executable>
      <Name>promote-sql-capable-candidates</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:build-real-db-data-quality:run-metadq" OperationId="operation:build-real-db-data-quality" PreviousStepId="operation-step:build-real-db-data-quality:deploy-data-quality-sql">
      <Arguments>execute --connection-env {env:META_DQ_REAL_DEMO_OPERATIONAL_SQL} --quiet --query "SET NOCOUNT ON; DECLARE @RunId bigint; EXEC dbo.Run @SourceDatabaseName = N'MetaDataQualityRealDbDemo', @RunId = @RunId OUTPUT;"</Arguments>
      <Executable>meta-sql.exe</Executable>
      <Name>run-metadq</Name>
    </OperationStep>
    <OperationStep Id="operation-step:build-real-db-data-quality:setup-demo-database" OperationId="operation:build-real-db-data-quality">
