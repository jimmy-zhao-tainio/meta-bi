      <Executable>cmd.exe</Executable>
      <Name>remove-data-quality-sql</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-data-quality-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-transform-workspace">
      <Arguments>/c if exist MetaDataQuality.Workspace rmdir /s /q MetaDataQuality.Workspace</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-data-quality-workspace</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-import-report" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-data-quality-sql">
      <Arguments>/c if exist SourceViews.import-report.tsv del /q SourceViews.import-report.tsv</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-import-report</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-transform-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:drop-demo-databases">
      <Arguments>/c if exist MetaTransformScript.Workspace rmdir /s /q MetaTransformScript.Workspace</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-transform-workspace</Name>
    </OperationStep>
