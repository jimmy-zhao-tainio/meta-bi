      <Executable>meta-sql.exe</Executable>
      <Name>setup-demo-database</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:drop-demo-databases" OperationId="operation:cleanup">
      <Arguments>execute --connection-env {env:META_DQ_REAL_DEMO_MASTER_SQL} --quiet --file cleanup-demo-db.sql --var DEMO_DB=MetaDataQualityRealDbDemo --var METADQ_DB=MetaDQ</Arguments>
      <Executable>meta-sql.exe</Executable>
      <Name>drop-demo-databases</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-data-quality-sql" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-data-quality-workspace">
