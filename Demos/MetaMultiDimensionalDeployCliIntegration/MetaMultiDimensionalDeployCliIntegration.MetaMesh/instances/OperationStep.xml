<?xml version="1.0" encoding="utf-8"?>
<MetaMesh>
  <OperationStepList>
    <OperationStep Id="operation-step:cleanup:remove-analytics-workspace" OperationId="operation:cleanup">
      <Arguments>/c if exist AnalyticsWorkspace rmdir /s /q AnalyticsWorkspace</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-analytics-workspace</Name>
    </OperationStep>
    <OperationStep Id="operation-step:cleanup:remove-multi-dimensional-workspace" OperationId="operation:cleanup" PreviousStepId="operation-step:cleanup:remove-analytics-workspace">
      <Arguments>/c if exist MultiDimensionalWorkspace rmdir /s /q MultiDimensionalWorkspace</Arguments>
      <Executable>cmd.exe</Executable>
      <Name>remove-multi-dimensional-workspace</Name>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-cell-permission" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-cube-action">
      <Arguments>add-cell-permission --workspace "{mesh.root}\MultiDimensionalWorkspace" --id ReaderSalesCells --security-role Readers --cube Commerce:cube --expression "Measures.CurrentMember IS [Measures].[Sales Amount]"</Arguments>
      <Executable>meta-multi-dimensional.exe</Executable>
      <Name>add-cell-permission</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-cube-action" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-named-set">
      <Arguments>add-cube-action --workspace "{mesh.root}\MultiDimensionalWorkspace" --id SalesDrillthrough --cube Commerce:cube --name "Sales Drillthrough" --action-type DrillThrough --target-kind Cells --expression DRILLTHROUGH</Arguments>
      <Executable>meta-multi-dimensional.exe</Executable>
      <Name>add-cube-action</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-data-source" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-model">
      <Arguments>add-data-source --workspace "{mesh.root}\AnalyticsWorkspace" --id Warehouse --model Commerce --name Warehouse --provider SqlServer --connection-reference COMMERCE_DW --source-kind Relational</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-data-source</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-date-key" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-date-table">
      <Arguments>add-attribute --workspace "{mesh.root}\AnalyticsWorkspace" --id DateKey --table Date --name DateKey --data-type-id meta:type:Int32 --is-key true --is-hidden true</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-date-key</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-date-table" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-data-source">
      <Arguments>add-table --workspace "{mesh.root}\AnalyticsWorkspace" --id Date --model Commerce --name Date --kind Dimension --data-category Time</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-date-table</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-measure" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-relationship">
      <Arguments>add-measure --workspace "{mesh.root}\AnalyticsWorkspace" --id SalesAmount --table Sales --source-attribute SalesAmountColumn --name "Sales Amount" --data-type-id meta:type:Decimal --format-string "#,0.00" --aggregate-function Sum</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-measure</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-model" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:new-analytics-workspace">
      <Arguments>add-model --workspace "{mesh.root}\AnalyticsWorkspace" --id Commerce --name Commerce --default-culture en-US</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-model</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-named-set" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:convert-to-multi-dimensional">
      <Arguments>add-named-set --workspace "{mesh.root}\MultiDimensionalWorkspace" --id TopDates --cube Commerce:cube --name TopDates --expression "TOPCOUNT([Date].[DateKey].MEMBERS, 10, [Measures].[Sales Amount])"</Arguments>
      <Executable>meta-multi-dimensional.exe</Executable>
      <Name>add-named-set</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-order-date-key" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-sales-table">
      <Arguments>add-attribute --workspace "{mesh.root}\AnalyticsWorkspace" --id OrderDateKey --table Sales --name OrderDateKey --data-type-id meta:type:Int32 --is-hidden true</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-order-date-key</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-partition" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-cell-permission">
      <Arguments>add-partition --workspace "{mesh.root}\MultiDimensionalWorkspace" --id SalesCurrent --measure-group "Sales:measure-group" --multi-dimensional-data-source Warehouse --name "Sales Current" --source-expression "SELECT * FROM mart.FactSales"</Arguments>
      <Executable>meta-multi-dimensional.exe</Executable>
      <Name>add-partition</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-relationship" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-sales-amount-column">
      <Arguments>add-relationship --workspace "{mesh.root}\AnalyticsWorkspace" --id SalesOrderDate --name OrderDate --role-name OrderDate --relationship-kind Regular --cardinality ManyToOne --from-table Sales --from-attribute OrderDateKey --to-table Date --to-attribute DateKey --is-active true</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-relationship</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-sales-amount-column" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-order-date-key">
      <Arguments>add-attribute --workspace "{mesh.root}\AnalyticsWorkspace" --id SalesAmountColumn --table Sales --name SalesAmount --data-type-id meta:type:Decimal --is-hidden true</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-sales-amount-column</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-sales-table" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-date-key">
      <Arguments>add-table --workspace "{mesh.root}\AnalyticsWorkspace" --id Sales --model Commerce --name Sales --kind Fact</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-sales-table</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:add-security-role" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-measure">
      <Arguments>add-security-role --workspace "{mesh.root}\AnalyticsWorkspace" --id Readers --model Commerce --name Readers --permission Read</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>add-security-role</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:convert-to-multi-dimensional" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-security-role">
      <Arguments>analytics-to-multi-dimensional --workspace "{mesh.root}\AnalyticsWorkspace" --output-xml "{mesh.root}\MultiDimensionalWorkspace"</Arguments>
      <Executable>meta-convert.exe</Executable>
      <Name>convert-to-multi-dimensional</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:deploy-multi-dimensional" OperationId="operation:deploy-multi-dimensional-model" PreviousStepId="operation-step:deploy-multi-dimensional-model:add-partition">
      <Arguments>deploy --workspace "{mesh.root}\MultiDimensionalWorkspace" --server localhost\MULTI --database-name MetaBiMultiDimensionalDeployDemo --drop-existing --no-process</Arguments>
      <Executable>meta-multi-dimensional.exe</Executable>
      <Name>deploy-multi-dimensional</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
    <OperationStep Id="operation-step:deploy-multi-dimensional-model:new-analytics-workspace" OperationId="operation:deploy-multi-dimensional-model">
      <Arguments>create --xml "{mesh.root}\AnalyticsWorkspace"</Arguments>
      <Executable>meta-analytics.exe</Executable>
      <Name>new-analytics-workspace</Name>
      <WorkingDirectory></WorkingDirectory>
    </OperationStep>
  </OperationStepList>
</MetaMesh>
