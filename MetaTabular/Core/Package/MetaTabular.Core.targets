<Project>
  <ItemGroup>
    <_MetaTabularPackagedWorkspace Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/Workspaces/**/*" />
  </ItemGroup>
  <Target Name="CopyMetaTabularPackagedWorkspaceToOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_MetaTabularPackagedWorkspace)" DestinationFiles="@(_MetaTabularPackagedWorkspace -> '$(OutDir)Workspaces/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMetaTabularPackagedWorkspaceToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <Copy SourceFiles="@(_MetaTabularPackagedWorkspace)" DestinationFiles="@(_MetaTabularPackagedWorkspace -> '$(PublishDir)Workspaces/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
