<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Meta.TypedModels" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.Integration" Version="$(MetaFoundationPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MetaDataType\Core\MetaDataType.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Workspaces\MetaTabular\MetaTabular.meta.cs" Link="MetaTabular.meta.cs" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="..\Workspaces\MetaTabular\**\*">
      <Link>Workspaces\MetaTabular\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Workspaces\MetaTabular\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <None Update="Package\MetaTabular.Core.targets" Pack="true" PackagePath="buildTransitive\MetaTabular.Core.targets" />
  </ItemGroup>

</Project>
