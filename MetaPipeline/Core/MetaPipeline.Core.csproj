<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meta.Core" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.TypedModels" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.Integration" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Workspaces\MetaPipeline\MetaPipeline.meta.cs" Link="MetaPipeline.meta.cs" />
    <ProjectReference Include="..\..\MetaDataType\Core\MetaDataType.Core.csproj" />
    <ProjectReference Include="..\..\MetaOrchestration\WorkerProtocol\MetaOrchestration.WorkerProtocol.csproj" />
    <ProjectReference Include="..\..\MetaTransform\Binding\MetaTransform.Binding.csproj" />
    <ProjectReference Include="..\..\MetaTransform\Script\Sql\MetaTransformScript.Sql.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="..\Workspaces\MetaPipeline\**\*">
      <Link>Workspaces\MetaPipeline\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Workspaces\MetaPipeline\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <None Update="Package\MetaPipeline.Core.targets" Pack="true" PackagePath="buildTransitive\MetaPipeline.Core.targets" />
  </ItemGroup>

</Project>
