<Model name="MetaPipeline">
  <EntityList>
    <Entity name="ConnectionReference">
      <PropertyList>
        <Property name="EnvironmentVariableName" />
        <Property name="Name" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="Pipeline" />
      </RelationshipList>
    </Entity>
    <Entity name="ExecutableTask">
      <PropertyList>
        <Property name="Arguments" isRequired="false" />
        <Property name="ExecutablePath" />
        <Property name="SuccessExitCode" isRequired="false" />
        <Property name="TimeoutSeconds" isRequired="false" />
        <Property name="WorkingDirectory" isRequired="false" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="PipelineTask" />
      </RelationshipList>
    </Entity>
    <Entity name="InsertRowsTargetWriteTask">
      <PropertyList>
        <Property name="BatchSize" isRequired="false" />
        <Property name="TargetDataTypeSystemName" isRequired="false" />
        <Property name="TargetSqlIdentifier" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="TargetWriteTask" />
      </RelationshipList>
    </Entity>
    <Entity name="Pipeline">
      <PropertyList>
        <Property name="Description" isRequired="false" />
        <Property name="Name" />
      </PropertyList>
    </Entity>
    <Entity name="PipelineTask">
      <PropertyList>
        <Property name="Name" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="Pipeline" />
      </RelationshipList>
    </Entity>
    <Entity name="RowStream">
      <PropertyList>
        <Property name="Name" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="Pipeline" />
      </RelationshipList>
    </Entity>
    <Entity name="RowStreamColumn">
      <PropertyList>
        <Property name="Name" />
        <Property name="Ordinal" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="RowStream" />
      </RelationshipList>
    </Entity>
    <Entity name="RowStreamConsumer">
      <RelationshipList>
        <Relationship entity="PipelineTask" />
        <Relationship entity="RowStream" />
      </RelationshipList>
    </Entity>
    <Entity name="RowStreamProducer">
      <RelationshipList>
        <Relationship entity="PipelineTask" />
        <Relationship entity="RowStream" />
      </RelationshipList>
    </Entity>
    <Entity name="TargetWriteTask">
      <RelationshipList>
        <Relationship entity="PipelineTask" />
        <Relationship entity="ConnectionReference" role="TargetConnectionReference" />
      </RelationshipList>
    </Entity>
    <Entity name="TaskDependency">
      <RelationshipList>
        <Relationship entity="Pipeline" />
        <Relationship entity="PipelineTask" role="Predecessor" />
        <Relationship entity="PipelineTask" role="Successor" />
      </RelationshipList>
    </Entity>
    <Entity name="TransformExecutionTask">
      <PropertyList>
        <Property name="BindingWorkspacePath" />
        <Property name="TimeoutSeconds" isRequired="false" />
        <Property name="TransformBindingId" />
        <Property name="TransformScriptId" />
        <Property name="TransformWorkspacePath" />
      </PropertyList>
      <RelationshipList>
        <Relationship entity="ConnectionReference" role="ExecutionConnectionReference" />
        <Relationship entity="PipelineTask" />
      </RelationshipList>
    </Entity>
  </EntityList>
</Model>