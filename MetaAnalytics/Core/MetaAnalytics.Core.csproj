<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meta.TypedModels" Version="$(MetaFoundationPackageVersion)" />
    <PackageReference Include="Meta.Integration" Version="$(MetaFoundationPackageVersion)" />
    <Compile Include="..\Workspaces\MetaAnalytics\MetaAnalytics.meta.cs" Link="MetaAnalytics.meta.cs" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="..\Workspaces\MetaAnalytics\**\*">
      <Link>Workspaces\MetaAnalytics\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Workspaces\MetaAnalytics\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <None Update="Package\MetaAnalytics.Core.targets" Pack="true" PackagePath="buildTransitive\MetaAnalytics.Core.targets" />
  </ItemGroup>

</Project>
